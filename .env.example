# Fireworks — https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=fw_xxxxxxxxxxxxxxxx

# SEC EDGAR requires a User-Agent with real contact info or it returns 403.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT=Your Name your@email.com

# Neo4j (matches docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword

# Postgres/pgvector — unused until Phase 2, service is up so the compose file stays stable
PG_DSN=postgresql://kgrag:devpassword@localhost:5432/kgrag
